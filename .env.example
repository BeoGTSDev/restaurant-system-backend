NODE_ENV=development
API_PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=restaurant_system
DB_USER=postgres
DB_PASSWORD=replace-with-local-database-password
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Generate a unique random value of at least 48 characters.
JWT_SECRET=replace-with-a-unique-random-secret-at-least-48-characters

# Comma-separated exact frontend origins. Configure every deployed frontend.
CLIENT_URL=http://localhost:5173,http://localhost:3000,http://localhost:3010

# Required only when the database has no users and the first administrator
# must be provisioned. Remove or rotate it after successful provisioning.
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-one-time-password
ALLOW_INSECURE_DEV_ADMIN=false
ADMIN_2FA_REQUIRED=false
ADMIN_ALLOWED_IPS=

# Optional verified bank-transfer integration.
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NAME=
SEPAY_WEBHOOK_SECRET=
SEPAY_API_KEY=
